{
  "schema_version": "0.1.0",
  "dataset_title": "Iron oxide magnetic nanoparticles for hyperthermia",
  "fields": [
    {
      "name": "record_id",
      "type": "string",
      "required": true,
      "description": "Unique identifier per record",
      "example": "IONP_HT_001"
    },
    {
      "name": "doi",
      "type": "string",
      "required": true,
      "description": "DOI of source publication",
      "example": "10.1039/D5RA00728C"
    },
    {
      "name": "core_material",
      "type": "string",
      "required": true,
      "description": "Chemical composition of magnetic core",
      "example": "Fe₃O₄"
    },
    {
      "name": "core_diameter_mean",
      "type": "number",
      "required": true,
      "description": "Mean core diameter",
      "unit": "nm",
      "example": 13.5
    },
    {
      "name": "core_diameter_std",
      "type": "number",
      "required": false,
      "description": "Standard deviation of core diameter",
      "unit": "nm",
      "example": 1.2
    },
    {
      "name": "core_shape",
      "type": "string",
      "required": false,
      "description": "Morphology",
      "example": "spherical"
    },
    {
      "name": "ms",
      "type": "number",
      "required": false,
      "description": "Saturation magnetization",
      "unit": "emu/g",
      "example": 80
    },
    {
      "name": "coating_material",
      "type": "string",
      "required": false,
      "description": "Surface coating composition",
      "example": "PEG2000"
    },
    {
      "name": "coating_thickness",
      "type": "number",
      "required": false,
      "description": "Coating layer thickness",
      "unit": "nm",
      "example": 3.5
    },
    {
      "name": "zeta_potential",
      "type": "number",
      "required": false,
      "description": "Surface charge",
      "unit": "mV",
      "example": -25
    },
    {
      "name": "hydrodynamic_diameter",
      "type": "number",
      "required": false,
      "description": "Hydrodynamic diameter",
      "unit": "nm",
      "example": 45
    },
    {
      "name": "synthesis_method",
      "type": "string",
      "required": false,
      "description": "Preparation route",
      "example": "thermal decomposition"
    },
    {
      "name": "frequency",
      "type": "number",
      "required": true,
      "description": "AMF frequency",
      "unit": "kHz",
      "example": 267
    },
    {
      "name": "amplitude",
      "type": "number",
      "required": true,
      "description": "AMF amplitude",
      "unit": "kA/m",
      "example": 27
    },
    {
      "name": "solvent_medium",
      "type": "string",
      "required": true,
      "description": "Dispersion medium",
      "example": "water"
    },
    {
      "name": "concentration",
      "type": "number",
      "required": true,
      "description": "Iron concentration",
      "unit": "mg/mL",
      "example": 10
    },
    {
      "name": "sar",
      "type": "number",
      "required": false,
      "description": "Specific Absorption Rate",
      "unit": "W/g",
      "example": 705.86
    },
    {
      "name": "ilp",
      "type": "number",
      "required": false,
      "description": "Intrinsic Loss Power = SAR/(f·H²)",
      "unit": "nHm²/kg",
      "example": 1.49
    },
    {
      "name": "extraction_notes",
      "type": "string",
      "required": false,
      "description": "Notes on ambiguity",
      "example": "SAR calculated from heating curve"
    }
  ],
  "anyOf": [
    { "required": ["sar"] },
    { "required": ["ilp"] }
  ]
}
